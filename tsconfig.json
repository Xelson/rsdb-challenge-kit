// Kit self-check: resolves @rsdb/client to the normative declarations.
// The judge points the path at the submission's built package instead.
{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "noUnusedLocals": false,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "@rsdb/client": ["./api/rsdb.d.ts"]
    }
  },
  "include": ["api/**/*.d.ts", "types/**/*.ts", "bench/**/*.ts", "accounting/**/*.ts", "conformance/**/*.ts"]
}
